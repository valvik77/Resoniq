#include <windows.h>
#include "resoniq_version.h"
1 ICON "../assets/brand/resoniq-app.ico"
2 ICON "../assets/brand/resoniq-tray-active.ico"
3 ICON "../assets/brand/resoniq-tray-bypass.ico"
4 ICON "../assets/brand/resoniq-tray-disconnected.ico"

1 VERSIONINFO
FILEVERSION RESONIQ_VERSION_RC
PRODUCTVERSION RESONIQ_VERSION_RC
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Valvik"
      VALUE "FileDescription", "Resoniq by Valvik"
      VALUE "FileVersion", RESONIQ_VERSION_TEXT
      VALUE "ProductName", "Resoniq by Valvik"
      VALUE "ProductVersion", RESONIQ_VERSION_TEXT
      VALUE "LegalCopyright", "Copyright (c) 2026 Victor Manuel Valenzuela (Valvik)"
      VALUE "OriginalFilename", "resoniq.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
