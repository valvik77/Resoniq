; DPS virtual transport only. No sample APOs or third-party effects.
[Version]
Signature="$Windows NT$"
Class=MEDIA
ClassGUID={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=10/11/2026,0.2.0.0
CatalogFile=DpsAudioVirtual.cat
PnpLockDown=1

[SourceDisksNames]
1=%DiskName%
[SourceDisksFiles]
DpsAudioVirtual.sys=1
[DestinationDirs]
Dps.Copy=13
[Manufacturer]
%Provider%=Dps,NTamd64.10.0...22621
[Dps.NTamd64.10.0...22621]
%DeviceName%=Dps.Install,ROOT\DPSAUDIOVIRTUAL

[Dps.Install.NT]
CopyFiles=Dps.Copy
AddReg=Dps.AddReg
[Dps.Copy]
DpsAudioVirtual.sys
[Dps.AddReg]
HKR,,AssociatedFilters,,"wdmaud"
HKR,,Driver,,DpsAudioVirtual.sys
HKR,Drivers,SubClasses,,"wave,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%DeviceName%
HKR,Drivers\mixer\wdmaud.drv,Description,,%DeviceName%

[Dps.Install.NT.Interfaces]
AddInterface=%Audio%,"WaveDps",Dps.Wave
AddInterface=%Render%,"WaveDps",Dps.Wave
AddInterface=%Realtime%,"WaveDps",Dps.Wave
AddInterface=%Audio%,"TopologyDps",Dps.Topology
AddInterface=%Topology%,"TopologyDps",Dps.Topology
[Dps.Wave]
AddReg=Dps.Wave.AddReg
[Dps.Wave.AddReg]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%EndpointName%
[Dps.Topology]
AddReg=Dps.Topology.AddReg
[Dps.Topology.AddReg]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%EndpointName%
HKR,EP\0,%Association%,,%Speaker%
HKR,EP\0,%EventDriven%,0x00010001,1

[Dps.Install.NT.Services]
AddService=DpsAudioVirtual,0x00000002,Dps.Service
[Dps.Service]
DisplayName=%DeviceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\DpsAudioVirtual.sys
AddReg=Dps.Service.AddReg
[Dps.Service.AddReg]
HKR,Parameters,DoNotCreateDataFiles,0x00010001,1
[Dps.Install.NT.Wdf]
KmdfService=DpsAudioVirtual,Dps.Wdf
[Dps.Wdf]
KmdfLibraryVersion=1.15

[Strings]
Provider="DPS Audio Engine"
DiskName="DPS Audio Virtual Driver"
DeviceName="DPS Audio Virtual Transport"
EndpointName="DPS Audio Speakers"
Proxy="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
Audio="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
Render="{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
Realtime="{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
Topology="{DDA54A40-1E4C-11D1-A050-405705C10000}"
Association="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
EventDriven="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"
Speaker="{DFF21CE1-F70F-11D0-B917-00A0C9223196}"
